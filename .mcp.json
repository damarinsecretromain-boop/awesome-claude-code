{
  "mcpServers": {
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp@3.38.0"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless"
      ]
    },
    "composio": {
      "type": "http",
      "url": "${COMPOSIO_MCP_URL}",
      "headers": {
        "x-api-key": "${COMPOSIO_API_KEY}"
      }
    }
  }
}
