# Copy to .env (git-ignored) or export these in your shell before launching Claude Code.
# They are read by .mcp.json via ${VAR} expansion.

# Firecrawl — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Composio — API key from https://platform.composio.dev (Settings > API keys)
COMPOSIO_API_KEY=
# Session MCP URL generated from the Composio dashboard or SDK
# (composio.create(userId, { toolkits: [...] }).mcp.url)
COMPOSIO_MCP_URL=
